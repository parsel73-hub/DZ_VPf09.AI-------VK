# ═══════════════════════════════════════════════════════════
#  AI-бот ВКонтакте (Gemini через ProxyAPI)
#  Скопируйте в .env и заполните значения
# ═══════════════════════════════════════════════════════════

# ── ВКонтакте ──────────────────────────────────────────────
# Токен группы (должен быть от имени группы)
# Создать: https://vk.com/editapp — вкладка "Токен доступа"
VK_GROUP_TOKEN=ваш_токен_группы

# ── Gemini через ProxyAPI ──────────────────────────────────
# Ключ от https://proxyapi.ru
PROXYAPI_KEY=ваш_proxyapi_key

# Базовый URL ProxyAPI (не менять)
PROXYAPI_BASE_URL=https://api.proxyapi.ru

# Версия Google API (v1beta для ProxyAPI)
GOOGLE_API_VERSION=v1beta

# Модель Gemini (список: https://proxyapi.ru/models/google)
GEMINI_MODEL=gemini-2.5-flash

# Параметры генерации
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_OUTPUT_TOKENS=2048

# ── Память и хранилище ─────────────────────────────────────
# Максимум сообщений в истории диалога
MAX_HISTORY=100

# Папка для JSON-файлов пользователей
USERS_DIR=users

# ── Лимиты ─────────────────────────────────────────────────
# Максимальная длина сообщения VK (4096 символов)
MAX_MESSAGE_LENGTH=4096

# ── Имитация набора текста ─────────────────────────────────
# Включить (true/false)
TYPING_ENABLED=true
# Символов в секунду
TYPING_SPEED=40
# Максимальное время задержки (секунды)
TYPING_MAX_SECONDS=8

# ── Таймауты и повторы ────────────────────────────────────
REQUEST_TIMEOUT_SEC=60
REQUEST_RETRIES=2

# ── Логирование ───────────────────────────────────────────
LOG_LEVEL=INFO
